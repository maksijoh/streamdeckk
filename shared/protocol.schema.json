{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deckremote.local/protocol/v1/schema.json",
  "title": "DeckRemote protocol v1",
  "oneOf": [
    {"$ref": "#/$defs/press"},
    {"$ref": "#/$defs/ack"},
    {"$ref": "#/$defs/config"},
    {"$ref": "#/$defs/ping"},
    {"$ref": "#/$defs/pong"}
  ],
  "$defs": {
    "requestId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}(?![\\s\\S])"
    },
    "buttonId": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*(?![\\s\\S])"},
    "integer": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "button": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label"],
      "properties": {
        "id": {"$ref": "#/$defs/buttonId"},
        "label": {"type": "string", "minLength": 1, "maxLength": 80},
        "icon": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9_-]+(?![\\s\\S])"}
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {"code": {"type": "string"}, "message": {"type": "string"}},
      "enum": [
        {"code": "unknown_button", "message": "Button does not exist"},
        {"code": "invalid_message", "message": "Invalid press message"},
        {"code": "action_failed", "message": "Action failed"},
        {"code": "unsupported_action", "message": "Action is unsupported or disabled"}
      ]
    },
    "press": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "requestId", "buttonId", "ts"],
      "properties": {
        "type": {"const": "press"},
        "requestId": {"$ref": "#/$defs/requestId"},
        "buttonId": {"$ref": "#/$defs/buttonId"},
        "ts": {"$ref": "#/$defs/integer"}
      }
    },
    "ack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "requestId", "buttonId", "ok", "error"],
      "properties": {
        "type": {"const": "ack"},
        "requestId": {"$ref": "#/$defs/requestId"},
        "buttonId": {"$ref": "#/$defs/buttonId"},
        "ok": {"type": "boolean"},
        "error": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/error"}]}
      },
      "oneOf": [
        {"properties": {"ok": {"const": true}, "error": {"type": "null"}}},
        {"properties": {"ok": {"const": false}, "error": {"$ref": "#/$defs/error"}}}
      ]
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "protocolVersion", "revision", "buttons"],
      "properties": {
        "type": {"const": "config"},
        "protocolVersion": {"type": "integer", "const": 1},
        "revision": {"$ref": "#/$defs/integer"},
        "buttons": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/button"}}
      }
    },
    "ping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "requestId", "ts"],
      "properties": {
        "type": {"const": "ping"},
        "requestId": {"$ref": "#/$defs/requestId"},
        "ts": {"$ref": "#/$defs/integer"}
      }
    },
    "pong": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "requestId", "ts"],
      "properties": {
        "type": {"const": "pong"},
        "requestId": {"$ref": "#/$defs/requestId"},
        "ts": {"$ref": "#/$defs/integer"}
      }
    },
    "clientMessage": {"oneOf": [{"$ref": "#/$defs/press"}, {"$ref": "#/$defs/ping"}]},
    "serverMessage": {"oneOf": [{"$ref": "#/$defs/ack"}, {"$ref": "#/$defs/config"}, {"$ref": "#/$defs/pong"}]}
  }
}
