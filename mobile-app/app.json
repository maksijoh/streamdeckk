{
  "expo": {
    "name": "DeckRemote",
    "slug": "deckremote",
    "version": "1.0.0",
    "orientation": "default",
    "ios": {
      "bundleIdentifier": "app.deckremote.mobile",
      "supportsTablet": true,
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Connect to your paired PC on your local Wi-Fi network.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "app.deckremote.mobile",
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Scan your PC’s DeckRemote pairing QR.",
          "recordAudioAndroid": false,
          "microphonePermission": false
        }
      ],
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "./plugins/withNoWebSocketRedirects.cjs",
      "expo-font"
    ]
  }
}
